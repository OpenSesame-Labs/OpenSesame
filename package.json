{
  "name": "opensesame",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*",
    "tests/redteam",
    "tests/visual-contract",
    "tests/fuzz/jazzer",
    "tools/mock-upstream-idp",
    "tools/oxlint/anti-slop"
  ],
  "scripts": {
    "bootstrap": "npm run deps:install && npm run db:migrate -w @opensesame/database && bash scripts/dev/setup-hooks.sh",
    "dev": "turbo run dev --parallel --filter=@opensesame/control-plane --filter=@opensesame/identity-worker --filter=@opensesame/mock-upstream-idp --filter=@opensesame/example-rp-alpha --filter=@opensesame/example-rp-beta --filter=@opensesame/example-static-rp",
    "dev:cli": "bash scripts/dev/dev-cli.sh",
    "dev:host": "bash scripts/dev/dev-host.sh",
    "dev:pwa": "npm run dev:web -w @opensesame/pages",
    "dev:daemon": "bash scripts/dev/dev-daemon.sh",
    "dev:live-nats": "npm exec -w @opensesame/cli -- tsx ../../scripts/dev/live-nats-operator.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "npm run audit:exposure && npm run lint:artifacts && npm run repo:check && npm run evidence:check && node scripts/quality/lint-changed.mjs",
    "lint:all": "npm run audit:exposure && npm run lint:artifacts && npm run repo:check && npm run evidence:check && biome check . && npm run lint:anti-slop",
    "lint:artifacts": "node apps/pages/scripts/build-static-auth.mjs --check && vitest run scripts/lib/static-auth-artifacts.test.mjs && npm run test -w @opensesame/static-auth && npm exec -w @opensesame/pages -- vitest run src/lib/auth-client.test.ts",
    "lint:design": "node scripts/quality/design-lint.mjs",
    "docs:index": "node scripts/quality/docs-index.mjs",
    "verify:formal-inventory": "node scripts/formal/inventory.mjs",
    "verify:formal-tlc-four": "node scripts/formal-tlc-four.mjs",
    "metrics:engineering": "node scripts/metrics/engineering-system-metrics.mjs",
    "lint:anti-slop": "node scripts/quality/anti-slop-gate.mjs",
    "lint:anti-slop:files": "oxlint --config oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity=error --deny-warnings --no-error-on-unmatched-pattern",
    "anti-slop:manifest": "node skills/install-anti-slop/scripts/manifest.mjs",
    "quality": "npm run audit:exposure && npm run quality:test && npm run quality:gate && npm run quality:log-hygiene && npm run quality:packages && npm run quality:app-core",
    "quality:log-hygiene": "node scripts/quality/log-hygiene-gate.mjs",
    "quality:test": "vitest run scripts/lib --testTimeout=30000 && node --test scripts/security/*.test.mjs scripts/quality/cd-pwa-workspace-paths-gate.test.mjs scripts/test/git-hooks.test.mjs scripts/test/grok-commit-guard.test.mjs scripts/quality/dependabot-config.test.mjs && npm run test:ci-promotion",
    "quality:gate": "node scripts/quality/quality-gate.mjs",
    "quality:app-core": "node scripts/quality/app-core-boundary.mjs --check",
    "quality:packages": "node scripts/quality/package-metrics-gate.mjs",
    "quality:bundle": "turbo run build --filter=@opensesame/pages && node scripts/quality/bundle-budget-gate.mjs",
    "quality:report": "node scripts/quality/quality-gate.mjs --summary && node scripts/quality/package-metrics-gate.mjs --report && node scripts/quality/bundle-budget-gate.mjs --report",
    "lint:fix": "biome check --write --changed --since=origin/main --no-errors-on-unmatched . && biome check --write --staged --no-errors-on-unmatched .",
    "setup:hooks": "bash scripts/dev/setup-hooks.sh",
    "test": "turbo run test --concurrency=1",
    "test:integration": "turbo run test:integration --concurrency=4",
    "test:e2e": "turbo run test:e2e",
    "test:security": "npm run test:security -w @opensesame/testing",
    "verify:auth-formal": "bash scripts/test/auth-formal.sh",
    "verify:authority-formal": "bash spec/formal/authority/check.sh",
    "verify:dpop-formal": "bash spec/formal/dpop/verify.sh",
    "verify:oauth-formal": "bash spec/formal/oauth/verify.sh",
    "verify:webauthn-formal": "bash spec/formal/webauthn/verify.sh",
    "verify:interaction-clock-formal": "bash spec/formal/interaction-clock/verify.sh",
    "test:redteam": "npm run redteam -w @opensesame/redteam",
    "test:visual": "npm run test:visual -w @opensesame/visual-contract",
    "test:anti-slop": "diff -ru --exclude=.turbo --exclude=MANIFEST.sha256 --exclude=node_modules --exclude=package.json --exclude=verify.mjs --exclude=vitest.config.ts skills/install-anti-slop/assets/anti-slop tools/oxlint/anti-slop && node skills/install-anti-slop/scripts/manifest.mjs --check && npm run typecheck:anti-slop && vitest run --root tools/oxlint/anti-slop",
    "test:rust-lint": "bash scripts/test/rust-lint-contract-test.sh",
    "test:plugin-boundary": "bash scripts/test/plugin-boundary-negative-control.sh",
    "test:authority-fabric": "node scripts/test/authority-fabric-gate.mjs",
    "test:authority-fabric:report": "node scripts/test/authority-fabric-gate.mjs --report",
    "wallet:verify": "node scripts/wallet/verify.mjs",
    "wallet:test:domain": "node scripts/wallet/test-domain.mjs",
    "wallet:test:contracts": "node scripts/wallet/contracts-harness.mjs",
    "wallet:test:protocols": "node scripts/wallet/run-suite.mjs protocols",
    "wallet:test:browser": "node scripts/wallet/run-suite.mjs browser",
    "wallet:test:security": "node scripts/wallet/run-suite.mjs security",
    "wallet:evidence": "node scripts/wallet/evidence.mjs",
    "typecheck:anti-slop": "tsc --noEmit --allowImportingTsExtensions --module NodeNext --moduleResolution NodeNext --target ESNext --skipLibCheck --types node tools/oxlint/anti-slop/index.ts tools/oxlint/anti-slop/effect/index.ts",
    "test:coverage:ts": "node scripts/quality/ts-coverage-gate.mjs",
    "test:coverage:rust": "cargo llvm-cov --workspace --all-targets --summary-only --fail-under-lines 69 --fail-under-functions 67 --json --output-path coverage/rust-summary.json",
    "test:coverage": "npm run test:coverage:ts && npm run test:coverage:rust",
    "test:mutation:ts": "stryker run tools/mutation/stryker.config.json",
    "test:mutation:duress": "stryker run tools/mutation/stryker.duress.config.json",
    "test:mutation:rust": "cargo mutants --gitignore true -p opensesame-redaction -p opensesame-task-bus -p opensesame-relay -p opensesame-connection-detect -p opensesame-human-vault -p opensesame-sealed-store -p opensesame-gateway -p opensesame-pki-core -p opensesame-storage --file crates/pki-core/src/policy.rs --file crates/pki-core/src/revocation.rs --file crates/pki-core/src/bundle.rs --file crates/storage/src/lib.rs --file crates/redaction/src/lib.rs --file crates/task-bus/src/validate.rs --file crates/relay/src/lib.rs --file crates/connection-detect/src/lib.rs --file crates/human-vault/src/lib.rs --file crates/sealed-store/src/attachment.rs --file crates/gateway/src/cert_issuers/model.rs -j 2 -o artifacts/mutation/rust",
    "test:mutation": "npm run test:mutation:ts && npm run test:mutation:rust",
    "audit:cve-lite": "bash ./scripts/audit/cve-lite-gate.sh",
    "audit:ast-grep": "bash ./scripts/audit/ast-grep-security-gate.sh",
    "audit:exposure": "node scripts/security/exposure-matrix-gate.mjs",
    "audit:clippy": "bash ./scripts/audit/clippy-gate.sh",
    "audit:browser-dispositions": "node scripts/audit/browser-disposition-probes.mjs",
    "audit:oauth-reach": "node scripts/audit/oauth-reach-probes.mjs",
    "audit:osv": "bash ./scripts/audit/osv-scanner-gate.sh",
    "audit:cargo-audit": "bash ./scripts/audit/cargo-audit-gate.sh",
    "audit:gitleaks": "bash ./scripts/audit/gitleaks-gate.sh",
    "audit:betterleaks": "bash ./scripts/audit/betterleaks-gate.sh",
    "patches:build": "node scripts/security/patched-dependencies.mjs build",
    "patches:verify": "node scripts/security/patched-dependencies.mjs verify",
    "audit:semgrep": "bash ./scripts/audit/semgrep-gate.sh",
    "audit:deepsec": "bash ./scripts/audit/deepsec-gate.sh",
    "audit:daemon-deps": "bash ./scripts/audit/daemon-deps-gate.sh",
    "audit:plugin-boundary": "bash ./scripts/audit/plugin-boundary-gate.sh",
    "audit:fuzz": "bash ./scripts/fuzz/fuzz-pr-gate.sh",
    "audit:fuzz:batch": "bash ./scripts/fuzz/fuzz-batch.sh",
    "audit:kani": "bash ./scripts/audit/kani-gate.sh",
    "audit:miri": "bash ./scripts/audit/miri-gate.sh",
    "audit:shuttle": "bash ./scripts/audit/shuttle-gate.sh",
    "test:fuzz": "bash ./scripts/fuzz/jazzer-gate.sh",
    "test:fuzz:batch": "FUZZ_SECONDS=${FUZZ_SECONDS:-300} bash ./scripts/fuzz/jazzer-gate.sh",
    "test:task-access": "bash ./scripts/test/task-security-battle-test.sh",
    "test:nats-dogfood": "bash ./scripts/test/nats-dogfood-test.sh",
    "test:proxied-run": "bash ./scripts/test/proxied-run-test.sh",
    "test:bitwarden-oracle": "bash ./scripts/test/bitwarden-oracle-test.sh",
    "test:2password-parity": "node --test scripts/test/2password-parity-runner.test.mjs && node scripts/test/2password-parity.mjs",
    "test:tailnet-sync:real": "bash scripts/test/tailnet-sync-real-tailnet.sh",
    "test:browser-sessions": "npm run test:browser-sessions -w @opensesame/pages",
    "test:live-stack": "bash ./scripts/test/live-stack-test.sh",
    "test:mtls": "bash ./scripts/mtls/mtls-test.sh",
    "test:mtls:integration": "bash ./scripts/mtls/mtls-integration-test.sh",
    "test:mtls:browser": "node scripts/mtls/mtls-browser-test.mjs",
    "test:mtls:fixtures": "bash ./scripts/mtls/mtls-fixtures.sh fetch all && bash ./scripts/mtls/mtls-fixtures.sh verify",
    "test:live-fixtures": "bash scripts/test/live-fixtures.sh",
    "test:all": "npm run typecheck && npm run test && npm run test:integration",
    "test:connect-preflight": "node scripts/test/connect-preflight.mjs",
    "verify:experience": "npm run verify:experience -w @opensesame/pages",
    "db:migrate": "npm run db:migrate -w @opensesame/database",
    "db:reset": "npm run db:reset -w @opensesame/database",
    "generate:openapi": "npm run generate:openapi -w @opensesame/control-plane",
    "generate:sbom": "mkdir -p sbom && npm exec --package=@cyclonedx/cdxgen@12.8.4 -- env -u NODE_PATH -u STARSHIP_SESSION_KEY cdxgen -o sbom/bom.json",
    "verify:key-protection": "node scripts/test/verify-key-protection.mjs",
    "verify:duress": "npm run verify:duress -w @opensesame/pages",
    "verify:duress:offline": "npm run verify:duress:offline -w @opensesame/pages",
    "verify:customer-vault-browser": "node scripts/test/verify-customer-vault-browser.mjs",
    "verify:sops-browser": "node scripts/test/verify-sops-browser.mjs",
    "verify:sops-conformance": "node scripts/test/verify-sops-conformance.mjs",
    "verify:sops-cloud-live": "node scripts/test/verify-sops-cloud-live.mjs",
    "verify": "npm run lint && npm run lint:anti-slop && npm run test:anti-slop && npm run quality && npm run test:rust-lint && npm run audit:clippy && npm run test:plugin-boundary && npm run test:all && cargo test --workspace --all-targets && ./scripts/test/battle-test.sh",
    "wallet:evidence:blocked-adapters": "node scripts/wallet/blocked-adapters.mjs",
    "evidence:check": "node scripts/quality/evidence-gate.mjs",
    "evidence:promote": "node scripts/dev/promote-evidence.mjs",
    "repo:check": "node scripts/quality/repository-size-gate.mjs && node scripts/dev/sync-agent-skills.mjs --check",
    "skills:install": "bash scripts/dev/install-agent-skills.sh --refresh",
    "skills:sync": "node scripts/dev/sync-agent-skills.mjs",
    "skills:check": "node scripts/dev/sync-agent-skills.mjs --check",
    "deps:install": "bash scripts/dev/install-dependencies.sh",
    "test:ci-promotion": "node --test scripts/release/*.test.mjs",
    "verify:auth-source": "node spec/auth-verification/source/verify.mjs && node --test spec/auth-verification/source/verify.test.mjs spec/auth-verification/source/extended.test.mjs"
  },
