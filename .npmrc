# Dependency install policy for every contributor, agent and CI job.
# Rationale and the exception procedure: docs/security/dependency-supply-chain.md

# A dependency's preinstall/install/postinstall script runs with the
# installing user's files, keys and tokens before anyone has read the package.
# Nothing in this workspace needs one: no workspace declares a pre/post npm
# script, and the installed tree builds and runs with scripts off.
ignore-scripts=true

# A new dependency is recorded at the exact version that was reviewed.
save-exact=true
