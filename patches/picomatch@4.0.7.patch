+  const byteLimit = Math.min(MAX_OUTPUT_BYTES, Math.max(4096, 512 + source.length * 4 + (input.length + 1) * 8 * (captures * 2 + 2)));
+  const shared = new SharedArrayBuffer(byteLimit + 8);
+  const signal = new Int32Array(shared, 0, 2);
+  const worker = workerFor();
+  worker.postMessage({ source, flags, input, lastIndex, shared });
+  if (Atomics.wait(signal, 0, 0, MATCH_TIMEOUT_MS) === 'timed-out' && Atomics.load(signal, 0) === 0) {
+    stopWorker();
+    throw new RangeError(`picomatch regular expression exceeded ${MATCH_TIMEOUT_MS} ms`);
+  }
+  if (Atomics.load(signal, 0) !== 1) {
+    stopWorker();
+    throw new RangeError('picomatch regular expression result exceeded the safe bound or its worker failed');
+  }
+  const { deserialize } = loadBuiltin('node:v8');
+  const { result, lastIndex: endIndex } = deserialize(Buffer.from(shared, 8, Atomics.load(signal, 1)));
+  if (useLastIndex) regex.lastIndex = endIndex;
+  if (result && result.groups) Object.setPrototypeOf(result.groups, null);
+  if (result && result.indices && result.indices.groups) Object.setPrototypeOf(result.indices.groups, null);
+  return result;
+};
+
+class BoundedRegExp extends RegExp {
+  exec(input) { return nodeExec(this, input); }
+}
+
+module.exports = (regex, hasExtglob) => {
+  const count = countRepetitions(regex.source);
+  const unsafe = hasUnsafeRepetition(regex.source) ||
+    (hasExtglob === true && count > 1) ||
+    (hasExtglob === undefined && count > 0);
+  if (!unsafe) return regex;
+  if (isNode) return new BoundedRegExp(regex.source, regex.flags);
+  throw new RangeError('picomatch cannot safely evaluate this expression in a synchronous browser runtime');
+};
