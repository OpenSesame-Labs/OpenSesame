+  let escaped = false, bracket = false;
+  for (let i = 0; i < source.length; i++) {
+    const ch = source[i];
+    if (escaped) { escaped = false; continue; }
+    if (ch === '\\') { escaped = true; continue; }
+    if (ch === '[' && !bracket) { bracket = true; continue; }
+    if (ch === ']' && bracket) { bracket = false; continue; }
+    if (bracket) continue;
+    if (ch === '(') {
+      const next = source.slice(i + 1, i + 4);
+      groups.push({ quantified: false, alternate: false, assertion: next.startsWith('?=') || next.startsWith('?!') || next === '?<=' || next === '?<!' });
+      continue;
+    }
+    if (ch === '|') { groups[groups.length - 1].alternate = true; continue; }
