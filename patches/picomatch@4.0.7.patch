+'use strict';
+const { parentPort, workerData } = require('node:worker_threads');
+const { serialize } = require('node:v8');
+parentPort.on('message', ({ source, flags, input, lastIndex, shared }) => {
+  const state = new Int32Array(shared, 0, 2);
+  try {
+    const expression = new RegExp(source, flags);
+    expression.lastIndex = lastIndex;
+    const result = expression.exec(input);
+    const data = serialize({ result, lastIndex: expression.lastIndex });
+    if (data.length > shared.byteLength - 8) {
+      Atomics.store(state, 0, -1);
+    } else {
+      new Uint8Array(shared, 8, data.length).set(data);
+      Atomics.store(state, 1, data.length);
+      Atomics.store(state, 0, 1);
+    }
+  } catch (error) {
+    Atomics.store(state, 0, -2);
+  }
+  Atomics.notify(state, 0);
+});
+const ready = new Int32Array(workerData.ready);
+Atomics.store(ready, 0, 1);
+Atomics.notify(ready, 0);
