+'use strict';
+
+// RegExp.exec cannot be interrupted on the event loop. Run identified
+// repeated ambiguous expressions on one reusable worker, and fail explicitly
+// on a deadline or serialization overflow, rather than weakening exclusions.
+const stateKey = Symbol.for('opensesame.picomatch.bounded-regex.v1');
+const sharedState = globalThis[stateKey] || (globalThis[stateKey] = { worker: null });
+const MATCH_TIMEOUT_MS = 250;
+const START_TIMEOUT_MS = 5000;
+const MAX_OUTPUT_BYTES = 16 * 1024 * 1024;
+
+const isNode = typeof process !== 'undefined' && process.versions && process.versions.node &&
+  typeof module !== 'undefined' && typeof module.require === 'function';
+
+const loadBuiltin = name => module.require(name);
+
+const countCaptures = source => {
+  let count = 0, escaped = false, bracket = false;
+  for (let i = 0; i < source.length; i++) {
+    const ch = source[i];
+    if (escaped) { escaped = false; continue; }
+    if (ch === '\\') { escaped = true; continue; }
+    if (ch === '[' && !bracket) { bracket = true; continue; }
+    if (ch === ']' && bracket) { bracket = false; continue; }
+    if (!bracket && ch === '(' &&
+        (source[i + 1] !== '?' || source[i + 2] === '<' && !'!='.includes(source[i + 3]))) count++;
+  }
+  return count;
+};
+
+// Conservatively identify repeated groups containing quantifiers or
+// alternatives. This does not cover every possible polynomial expression.
+const hasUnsafeRepetition = source => {
+  const groups = [{ quantified: false, alternate: false }];
+  let escaped = false, bracket = false;
+  for (let i = 0; i < source.length; i++) {
+    const ch = source[i];
+    if (escaped) { escaped = false; continue; }
+    if (ch === '\\') { escaped = true; continue; }
+    if (ch === '[' && !bracket) { bracket = true; continue; }
+    if (ch === ']' && bracket) { bracket = false; continue; }
+    if (bracket) continue;
+    if (ch === '(') {
+      const next = source.slice(i + 1, i + 4);
+      groups.push({ quantified: false, alternate: false, assertion: next.startsWith('?=') || next.startsWith('?!') || next === '?<=' || next === '?<!' });
+      continue;
+    }
+    if (ch === '|') { groups[groups.length - 1].alternate = true; continue; }
+    if (ch === ')' && groups.length > 1) {
+      const group = groups.pop();
+      const next = source.slice(i + 1);
+      const range = /^\{(\d+)(?:,(\d*))?\}/.exec(next);
+      const repeated = next[0] === '*' || next[0] === '+' || Boolean(range &&
+        (range[2] === '' || Number(range[2] === undefined ? range[1] : range[2]) > 1));
+      if (repeated && (group.quantified || group.alternate)) return true;
+      if (!group.assertion) {
+        if (group.quantified) groups[groups.length - 1].quantified = true;
+        if (group.alternate) groups[groups.length - 1].alternate = true;
+      }
+      continue;
+    }
+    const optional = ch === '?' && source[i - 1] !== '(' && !'*+?}'.includes(source[i - 1]);
+    const range = ch === '{' && /^\{\d+(?:,\d*)?\}/.test(source.slice(i));
+    if (ch === '*' || ch === '+' || optional || range) groups[groups.length - 1].quantified = true;
+  }
+  return false;
+};
+
+const stopWorker = () => {
+  const worker = sharedState.worker;
+  sharedState.worker = null;
+  if (worker) worker.terminate().catch(() => {});
+};
+
+const workerFor = () => {
+  if (sharedState.worker) return sharedState.worker;
+  const { Worker } = loadBuiltin('node:worker_threads');
+  const ready = new SharedArrayBuffer(4);
+  const signal = new Int32Array(ready);
+  const worker = new Worker(`${__dirname}/bounded-worker.js`, { workerData: { ready }, execArgv: [] });
+  worker.unref();
+  worker.on('error', () => { if (sharedState.worker === worker) sharedState.worker = null; });
+  worker.on('exit', () => { if (sharedState.worker === worker) sharedState.worker = null; });
+  sharedState.worker = worker;
+  if (Atomics.wait(signal, 0, 0, START_TIMEOUT_MS) === 'timed-out' && Atomics.load(signal, 0) === 0) {
+    stopWorker();
+    throw new RangeError('picomatch regex worker failed to start within its deadline');
+  }
+  return worker;
+};
+
+// Use intrinsic getters because user code may shadow `.source` or `.global`;
+// RegExpBuiltinExec itself reads internal slots rather than those properties.
+const getter = name => Object.getOwnPropertyDescriptor(RegExp.prototype, name).get;
+const intrinsicSource = getter('source');
+const flagGetters = [['d', 'hasIndices'], ['g', 'global'], ['i', 'ignoreCase'], ['m', 'multiline'],
+  ['s', 'dotAll'], ['u', 'unicode'], ['v', 'unicodeSets'], ['y', 'sticky']]
+  .map(([flag, name]) => [flag, Object.getOwnPropertyDescriptor(RegExp.prototype, name)?.get]);
+
+const nodeExec = (regex, input) => {
+  if (typeof input === 'symbol') throw new TypeError('Cannot convert a Symbol value to a string');
+  input = String(input);
+  const source = intrinsicSource.call(regex);
+  const flags = flagGetters.filter(([, read]) => read && read.call(regex)).map(([flag]) => flag).join('');
+  const useLastIndex = flags.includes('g') || flags.includes('y');
+  const lastIndex = +regex.lastIndex;
+  const captures = countCaptures(source);
+  const byteLimit = Math.min(MAX_OUTPUT_BYTES, Math.max(4096, 512 + source.length * 4 + (input.length + 1) * 8 * (captures * 2 + 2)));
+  const shared = new SharedArrayBuffer(byteLimit + 8);
+  const signal = new Int32Array(shared, 0, 2);
+  const worker = workerFor();
+  worker.postMessage({ source, flags, input, lastIndex, shared });
+  if (Atomics.wait(signal, 0, 0, MATCH_TIMEOUT_MS) === 'timed-out' && Atomics.load(signal, 0) === 0) {
+    stopWorker();
+    throw new RangeError(`picomatch regular expression exceeded ${MATCH_TIMEOUT_MS} ms`);
+  }
+  if (Atomics.load(signal, 0) !== 1) {
+    stopWorker();
+    throw new RangeError('picomatch regular expression result exceeded the safe bound or its worker failed');
+  }
+  const { deserialize } = loadBuiltin('node:v8');
+  const { result, lastIndex: endIndex } = deserialize(Buffer.from(shared, 8, Atomics.load(signal, 1)));
+  if (useLastIndex) regex.lastIndex = endIndex;
+  if (result && result.groups) Object.setPrototypeOf(result.groups, null);
+  if (result && result.indices && result.indices.groups) Object.setPrototypeOf(result.indices.groups, null);
+  return result;
+};
+
+class BoundedRegExp extends RegExp {
+  exec(input) { return nodeExec(this, input); }
+}
+
+module.exports = regex => {
+  if (!hasUnsafeRepetition(regex.source)) return regex;
+  if (isNode) return new BoundedRegExp(regex.source, regex.flags);
+  if (hasUnsafeRepetition(regex.source)) {
+    throw new RangeError('picomatch cannot safely evaluate this expression in a synchronous browser runtime');
+  }
+  return regex;
+};
