+  let count = 0, escaped = false, bracket = false;
+  for (let i = 0; i < source.length; i++) {
+    const ch = source[i];
+    if (escaped) { escaped = false; continue; }
+    if (ch === '\\') { escaped = true; continue; }
+    if (ch === '[' && !bracket) { bracket = true; continue; }
+    if (ch === ']' && bracket) { bracket = false; continue; }
+    if (!bracket && ch === '(' &&
+        (source[i + 1] !== '?' || source[i + 2] === '<' && !'!='.includes(source[i + 3]))) count++;
+  }
+  return count;
+};
+
+// Conservatively identify repeated groups containing quantifiers or
+// alternatives. This does not cover every possible polynomial expression.
+const hasUnsafeRepetition = source => {
