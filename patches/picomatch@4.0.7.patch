+const START_TIMEOUT_MS = 5000;
+const MAX_OUTPUT_BYTES = 16 * 1024 * 1024;
+
+const isNode = typeof process !== 'undefined' && process.versions && process.versions.node &&
+  typeof module !== 'undefined' && typeof module.require === 'function';
+
